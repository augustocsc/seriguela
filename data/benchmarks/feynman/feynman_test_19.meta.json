  "pmlb_metadata": {
    "dataset": "feynman_test_19",
    "description": "A synthetic physics model from the Feynman Lectures on Physics.         \nThis is the version of the model with units.\nFormula and simulated variable ranges given below. \n\npr = -1/(8*pi*G)*(c**4*k_f/r**2+H_G**2*c**2*(1-2*alpha))\n\nG in [1.0,5.0]\nk_f in [1.0,5.0]\nr in [1.0,5.0]\nH_G in [1.0,5.0]\nalpha in [1.0,5.0]\nc in [1.0,5.0]\n\nNote the original data has been down-sampled to 100,000 rows (see source). \n",
    "source": "Feynman Symbolic Regression Database https://space.mit.edu/home/tegmark/aifeynman.html",
    "publication": "AI Feynman - a Physics-Inspired Method for Symbolic Regression, Udrescu & Tegmark (2019), arXiv:1905.11481",
    "task": "regression",
    "keywords": [
      "symbolic regression",
      "physics"
    ],
    "target": {
      "type": "continuous",
      "description": "pr, Pressure, m^(-1) * s^(-2) * kg^1"
    },
    "features": [
      {
        "name": "G",
        "type": "continuous",
        "description": "Newton's constant, m^3 * s^(-2) * kg^(-1)"
      },
      {
        "name": "k_f",
        "type": "continuous",
        "description": "Dimensionless"
      },
      {
        "name": "r",
        "type": "continuous",
        "description": "Length, m^1"
      },
      {
        "name": "H_G",
        "type": "continuous",
        "description": "Hubble constant, s^(-1)"
      },
      {
        "name": "alpha",
        "type": "continuous",
        "description": "Dimensionless"
      },
      {
        "name": "c",
        "type": "continuous",
        "description": "Velocity, m^1 * s^(-1)"
      }
    ]
  }
}
