  "pmlb_metadata": {
    "dataset": "feynman_test_7",
    "description": "A synthetic physics model from the Feynman Lectures on Physics.         \nThis is the version of the model with units.\nFormula and simulated variable ranges given below. \n\nH_G = sqrt(8*pi*G*rho/3-alpha*c**2/d**2)\n\nG in [1.0,3.0]\nrho in [1.0,3.0]\nalpha in [1.0,2.0]\nc in [1.0,2.0]\nd in [1.0,3.0]\n\nNote the original data has been down-sampled to 100,000 rows (see source). \n",
    "source": "Feynman Symbolic Regression Database https://space.mit.edu/home/tegmark/aifeynman.html",
    "publication": "AI Feynman - a Physics-Inspired Method for Symbolic Regression, Udrescu & Tegmark (2019), arXiv:1905.11481",
    "task": "regression",
    "keywords": [
      "symbolic regression",
      "physics"
    ],
    "target": {
      "type": "continuous",
      "description": "H_G, Hubble constant, s^(-1)"
    },
    "features": [
      {
        "name": "G",
        "type": "continuous",
        "description": "Newton's constant, m^3 * s^(-2) * kg^(-1)"
      },
      {
        "name": "rho",
        "type": "continuous",
        "description": "Density, m^(-3) * kg^1"
      },
      {
        "name": "alpha",
        "type": "continuous",
        "description": "Dimensionless"
      },
      {
        "name": "c",
        "type": "continuous",
        "description": "Velocity, m^1 * s^(-1)"
      },
      {
        "name": "d",
        "type": "continuous",
        "description": "Length, m^1"
      }
    ]
  }
}
