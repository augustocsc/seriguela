{
  "name": "feynman_test_7",
  "n_samples": 100000,
  "n_vars": 5,
  "variables": [
    "G",
    "rho",
    "alpha",
    "c",
    "d"
  ],
  "target": "target",
  "source": "PMLB (official)",
